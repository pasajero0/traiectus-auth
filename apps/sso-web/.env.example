# Copy to .env.local. Never commit it.

# Server-side only — the browser never reaches sso-api. ADR-0004.
SSO_API_URL=http://localhost:4000

# Required. Must match sso-api's INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=replace-me

# This app's own public origin, used to build redirects.
SSO_WEB_URL=http://localhost:4100
