# Copy to .env.local for local development. Never commit .env.local.

# The identity service this application authenticates against.
SSO_WEB_URL=http://localhost:4100
SSO_API_URL=http://localhost:4000

# Registered with the identity service in config, not through a UI.
TRAIECTUS_CLIENT_ID=harbor
TRAIECTUS_CLIENT_SECRET=replace-me

# This application's own API — the browser calls it with a bearer token,
# exactly as the mobile client will.
NEXT_PUBLIC_HARBOR_API_URL=http://localhost:3100

APP_BASE_URL=http://localhost:3000
