# Copy to .env.local. Never commit it.

SSO_WEB_URL=http://localhost:4100
SSO_API_URL=http://localhost:4000

# Registered with the identity service in config, not through a UI.
TRAIECTUS_CLIENT_ID=harbor
TRAIECTUS_CLIENT_SECRET=replace-me

# Required. 32 random bytes. Seals the cookie holding both tokens. ADR-0008.
SESSION_SEAL_KEY=replace-me

# Server-side only — the browser never calls this API. ADR-0008.
HARBOR_API_URL=http://localhost:3100

APP_BASE_URL=http://localhost:3000
