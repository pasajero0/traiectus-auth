# Copy to .env. Never commit it.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Postgres connection string
DATABASE_URL=postgres://traiectus:traiectus@localhost:5432/traiectus

# Must match sso-web's INTERNAL_API_KEY
INTERNAL_API_KEY=replace-me

# EdDSA private key, one-line JWK
ACCESS_TOKEN_PRIVATE_KEY=

# sso-web's URL, not this service's
ISSUER=http://localhost:4100

# 32 random bytes, base64
REFRESH_SUCCESSOR_ENCRYPTION_KEY=

# Registered clients, JSON: [{"id","secret","redirectUris","name","homeUrl"}]
CLIENTS=
