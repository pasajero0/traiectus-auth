# Copy to .env. Never commit it.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Required. Postgres — see "Running locally" in the README.
DATABASE_URL=postgres://traiectus:traiectus@localhost:5432/traiectus

# Required. 32 random bytes. Must match sso-web's INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=replace-me

# EdDSA private key, one-line JWK. Its public half goes to both product APIs.
ACCESS_TOKEN_PRIVATE_KEY=

# The identity service's own origin. Goes into every access token's iss and every
# authorization response's iss — ADR-0017. Required once tokens or codes are issued.
ISSUER=

# Encrypts the successor refresh token while the ten-second replay window is open — ADR-0009.
# 32 random bytes, base64. Required once refresh tokens rotate; a wrong length fails at boot.
REFRESH_SUCCESSOR_ENCRYPTION_KEY=

# Registered clients, as JSON: [{"id","secret","redirectUris","name","homeUrl"}]. Clients
# are configuration, not database rows — src/clients.ts. Required once a code is issued or
# GET /v1/clients is called.
CLIENTS=
