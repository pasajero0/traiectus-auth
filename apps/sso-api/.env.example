# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Postgres. Local: docker run -e POSTGRES_PASSWORD=... -p 5432:5432 postgres:16
DATABASE_URL=postgres://traiectus:traiectus@localhost:5432/traiectus

# Shared secret presented by sso-web on internal endpoints. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=replace-me

# Signing key for access tokens (EdDSA). Generated on day 5; see ADR-0001.
ACCESS_TOKEN_PRIVATE_KEY=
