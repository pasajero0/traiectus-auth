{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "SSO_API_URL",
    "SSO_WEB_URL",
    "INTERNAL_API_KEY",
    "ACCESS_TOKEN_PUBLIC_KEY",
    "ISSUER",
    "TRAIECTUS_CLIENT_ID",
    "TRAIECTUS_CLIENT_SECRET",
    "SESSION_SEAL_KEY",
    "HARBOR_API_URL",
    "BEACON_API_URL",
    "APP_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {}
  }
}
